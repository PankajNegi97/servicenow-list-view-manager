{
  "manifest_version": 3,
  "name": "List View Manager for ServiceNow",
  "description": "Save, capture, export, and apply ServiceNow list column profiles effortlessly.",
  "version": "1.2.0",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],

  "host_permissions": [
    "*://*.service-now.com/*",
    "*://*.servicenow.com/*"
  ],

  "action": {
    "default_title": "List View Manager for ServiceNow",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "background": {
    "service_worker": "background.js"
  }
}
